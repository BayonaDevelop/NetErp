{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceName": "gateway",
  "HttpClientName": "openapi-aggregator",
  "Jwt": {
    "Issuer": "netErp.identity",
    "Audience": "netErp.clients"
  },
  "ReverseProxy": {
    "Clusters": {
      "address-cluster": {
        "Destinations": {
          "address-api-destination1": {
            "Address": "http://address.api:8080/"
          }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-api-destination1": {
            "Address": "http://identity.api:8080/"
          }
        }
      }
    },
    "Routes": {
      "address-openapi": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/openapi/address.json"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "address-add": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/",
          "Methods": [ "POST" ]
        }
      },
      "address-get-by-id": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/{addressId}",
          "Methods": [ "GET" ]
        }
      },
      "address-get-countries": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/country/all",
          "Methods": [ "GET" ]
        }
      },
      "address-get-cities": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/country/{countryId}/city",
          "Methods": [ "GET" ]
        }
      },
      "address-get-municipalities": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/city/{cityId}/municipality",
          "Methods": [ "GET" ]
        }
      },
      "address-get-localities": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/municipality/{municipalityId}/locality",
          "Methods": [ "GET" ]
        }
      },
      "address-get-settlement-types": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/settlement-types",
          "Methods": [ "GET" ]
        }
      },
      "address-get-settlements": {
        "ClusterId": "address-cluster",
        "Match": {
          "Path": "/api/v1/addresses/locality/{localityId}/settlement",
          "Methods": [ "GET" ]
        }
      },
      "identity-openapi": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/openapi/identity.json"
        },
        "Transforms": [
          { "PathSet": "/openapi/v1.json" }
        ]
      },
      "identity-create-user": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/create-user",
          "Methods": [ "POST" ]
        }
      },
      "identity-login": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/login",
          "Methods": [ "POST" ]
        }
      },
      "identity-refresh-token": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/refresh-token",
          "Methods": [ "POST" ]
        }
      },
      "identity-logout": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/logout",
          "Methods": [ "POST" ]
        }
      },
      "identity-get-company-users": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/get-company-users",
          "Methods": [ "GET" ]
        }
      },
      "identity-get-user": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/api/v1/auth/get-user",
          "Methods": [ "GET" ]
        }
      }
    }
  }
}
