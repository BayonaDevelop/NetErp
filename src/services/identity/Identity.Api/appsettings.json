{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ServiceName": "api-identity",
  "Kestrel": {
    "RequireClientCertificate": false,
    "Certificate": {
      "Path": "",
      "Password": ""
    }
  },
  "Jwt": {
    "Issuer": "netErp.identity",
    "Audience": "netErp.clients",
    "DurationInMinutes": 60
  }
}
